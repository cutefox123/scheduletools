  },

  "ward": {
    "words": ["病", "二期"],
    "anyWords": ["介入"],
    "excludeWith": ["门诊"]
  },

  "time": {
    "dayStart": "07:30",
    "amEnd": "12:00",
    "pmStartSummer": "14:00",
    "pmStartWinter": "13:30",
    "pmEndSummer": "17:30",
    "pmEndWinter": "17:00",
    "wardOffsetMinutes": 30,
    "midStart": "12:00",
    "nightStartSummer": "17:30",
    "nightStartWinter": "17:00",
    "nightHandover": "07:30",
    "summerMonths": [5, 6, 7, 8, 9]
  }
