    "mid": { "contains": ["中"], "exclude": ["中医门诊", "中午"] },
    "rest": {
      "anyOf": ["假", "公休", "病休", "帮扶", "进修"],
      "contains": "休"
    },
    "workWords": [
      "查", "诊", "病", "房", "术", "门诊", "床旁", "介入",
      "行政", "科研", "东", "西", "产", "妇", "乳", "急", "麻醉"
    ],
    "separators": ["/", "\\", "|", "-", "—", "~", "．", ".", "、", "，", ",", "。"]
  },

  "mid": {
    "trigger": "中",
    "dutyKey": "值中",
    "dutyContains": "值",
    "mainKey": "中",
    "ignoredChars": ["东", "西", "南", "北", "总", "院", "值", "班"],
    "districts": [
      { "key": "东中", "contains": "东" },
      { "key": "西中", "contains": "西" },
      { "key": "南中", "contains": "南" },
      { "key": "北中", "contains": "北" }
    ],
    "fallbackToMain": false
